# Image de l'API FastAPI : pilote les entraînements via le CLI flwr
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt && rm -rf /root/.cache/pip

COPY pyproject.toml .flwrignore ./
COPY src ./src

# Connexion au SuperLink du déploiement (réseau Docker "fl-server")
RUN mkdir -p /root/.flwr && printf '[superlink]\ndefault = "fl-server"\n\n[superlink.fl-server]\naddress = "fl-server:9093"\ninsecure = true\n' > /root/.flwr/config.toml

EXPOSE 8001

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
